
@model InvestmentPortfolioManagement.Models.Asset
@{
    Layout = ViewData["Layout"]?.ToString();
    ViewData["Title"] = "Add Investment";
}

<h2>Add Investment</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="PortfolioId" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Asset</label>
        <select asp-for="Name" class="form-select" id="assetDropdown">
            <option disabled selected>-- Select Asset --</option>
            @foreach (var item in ViewBag.AssetTemplates)
            {
                <option value="@item.Name" data-price="@item.BasePrice" data-type="@item.AssetType">@item.Name (@item.Symbol)</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="AssetType" class="form-label">Type</label>
        <input asp-for="AssetType" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="BasePrice" class="form-label">Base Price</label>
        <input asp-for="BasePrice" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label">Quantity</label>
        <input asp-for="Quantity" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Add Investment</button>
</form>

@section Scripts {
    <script>
        document.getElementById("assetDropdown").addEventListener("change", function () {
            var selected = this.options[this.selectedIndex];
            document.getElementById("BasePrice").value = selected.getAttribute("data-price");
            document.getElementById("AssetType").value = selected.getAttribute("data-type");
        });
    </script>
}
