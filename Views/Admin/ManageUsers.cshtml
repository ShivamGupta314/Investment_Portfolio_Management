@model List<InvestmentPortfolioManagement.Models.User>
@{
    ViewData["Title"] = "Manage Users";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-4">User Management</h2>

<table class="table table-bordered table-hover" style="background-color: #fff;">
    <thead style="background-color: #e3e6f0;">
        <tr>
            <th>Username</th>
            <th>Email</th>
            @* <th>Role</th> *@
            <th>Registered On</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var user in Model)
            {
                if (user.Username != "admin")
                {
                    <tr data-user-row-id="@user.UserId">
                        <td>@user.Username</td>
                        <td>@user.Email</td>
                        @* <td>@user.Role</td> *@
                        <td>@user.RegisteredDate.ToString("dd MMM yyyy")</td>
                        <td class="d-flex gap-2">
                            @* <a asp-action="EditUser" asp-controller="Admin" asp-route-id="@user.UserId" *@
                            @*    class="btn btn-outline-primary btn-sm"> *@
                            @*     <i class="fas fa-edit"></i> Edit *@
                            @* </a> *@
                            <button type="button" class="btn btn-outline-danger btn-sm delete-user-btn" data-user-id="@user.UserId">
                                <i class="fas fa-trash-alt"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No users found.</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $(".delete-user-btn").click(function () {
                const button = $(this);
                const userId = button.data("user-id");

                if (confirm("Are you sure you want to delete this user?")) {
                    $.ajax({
                        url: '/Admin/DeleteUser',
                        type: 'POST',
                        data: { id: userId },
                        success: function (response) {
                            if (response.success) {
                                // remove the row visually
                                button.closest("tr").fadeOut(300, function () { $(this).remove(); });
                            } else {
                                alert(response.message || "Failed to delete user.");
                            }
                        },
                        error: function () {
                            alert("Server error occurred.");
                        }
                    });
                }
            });
        });
    </script>
}
