
@{
    Layout = ViewData["Layout"]?.ToString();
    ViewData["Title"] = "Admin Dashboard";
}

<h2>Admin Dashboard</h2>
<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
<div class="row">
    <div class="col-md-3">
        <a asp-controller="Admin" asp-action="Users" style="text-decoration:none;"><div class="card bg-primary text-white p-3">
            <h5>Total Users</h5>
            <p>@ViewBag.UserCount</p>
        </div></a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Admin" asp-action="Portfolios" style="text-decoration:none;"><div class="card bg-success text-white p-3">
            <h5>Total Portfolios</h5>
            <p>@ViewBag.PortfolioCount</p>
        </div></a>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white p-3">
            <h5>Avg Portfolio Value</h5>
            <p>@ViewBag.AveragePortfolioValue</p>
        </div></a>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark p-3">
            <h5>Common Asset Type</h5>
            <p>@ViewBag.CommonAssetType</p>
        </div>
    </div>
</div>
