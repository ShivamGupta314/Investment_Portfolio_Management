@model List<Investment>

@{
    ViewBag.Title = "Investment Portfolio";
}

@* Ensure portfolio-table.css is linked in _Layout.cshtml, or link it here if this view is standalone *@
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:400,500,300,700" />
<link rel="stylesheet" href="~/css/portfolio-table.css" asp-append-version="true" />

<section>
    <center><h2>My Investments</h2></center>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="tbl-header">
        <table cellpadding="0" cellspacing="0" border="0">
            <thead>
                <tr>
                    <th>Asset Name</th>
                    <th>Quantity</th>
                    <th>Current Price</th>
                    <th>Purchased Price</th>
                    <th>Total Value</th>
                    <th>Purchased Date</th>
                    @* Add a header for actions if you plan to include Edit/Delete for investments * @
                    @* <th>Actions</th> *@
                </tr>
            </thead>
        </table>
    </div>

    <div class="tbl-content">
        <table cellpadding="0" cellspacing="0" border="0">
            <tbody>
                @foreach (var investment in Model)
                {
                    <tr>
                        <td>@investment.Asset.Name</td>
                        <td>@investment.Quantity</td>
                        <td>@investment.CurrentPrice.ToString("C")</td> @* Format as currency *@
                        <td>@investment.PurchasePrice.ToString("C")</td> @* Format as currency *@
                        <td>@((investment.CurrentPrice * investment.Quantity).ToString("C"))</td> @* Format as currency *@
                        <td>@investment.InvestmentDate.ToShortDateString()</td>
                        @* Add action buttons here if needed * @
                        @* <td class="investment-actions">
                            <div class="d-flex flex-wrap gap-1">
                                <a asp-action="EditInvestment" asp-route-id="@investment.InvestmentId" class="btn btn-warning btn-sm" aria-label="Edit Investment"><i class="fas fa-edit"></i></a>
                                <form asp-action="DeleteInvestment" asp-route-id="@investment.InvestmentId" method="post" class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this investment?');">
                                    <button type="submit" class="btn btn-danger btn-sm" aria-label="Delete Investment"><i class="fas fa-trash-alt"></i></button>
                                </form>
                            </div>
                        </td> *@
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <center>
    <a href="@Url.Action("Create", new { portfolioId = ViewBag.PortfolioId })" class="btn mt-3" style="background-color:#3498db; color:white">
        <i class="fas fa-plus"></i> Invest in this Portfolio
        </a>
    </center>
</section>