@model InvestmentPortfolioManagement.ViewModels.InvestmentViewModel

@{
    ViewData["Title"] = "Add Investment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        @* Adjusted column size for a consistent form width, similar to Create Portfolio *@
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border-0" style="box-shadow: rgba(0, 0, 0, 0.1) 0px 0px 5px 0px, rgba(0, 0, 0, 0.1) 0px 0px 1px 0px; ">
                <div class="card-header  bg-gradient text-white" style="background-color:#3498db">
                 <center>
                        <h2 class="card-title mb-0 fs-4" >
                        <i class="fas fa-coins"></i> Add New Investment
                    </h2>
                    </center>
                </div>
                <div class="card-body p-4">
                    @* Display TempData messages *@
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @* Display validation summary for non-field specific errors *@
                    @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3" })

                    <form asp-action="Create" asp-controller="Investment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="PortfolioId" />

                        <div class="row g-3">
                            @* Using Bootstrap grid for spacing and responsiveness *@
                            <div class="col-md-12">
                                @* Full width for the select asset dropdown *@
                                <div class="form-floating mb-3">
                                    <select asp-for="AssetId" class="form-select" required>
                                        <option value=""></option>
                                        @foreach (var asset in Model.AvailableAssets)
                                        {
                                            <option value="@asset.AssetId">@asset.Name (@asset.Symbol)</option>
                                        }
                                    </select>
                                    <label asp-for="AssetId">Select Asset</label> @* Label goes after select for floating effect *@
                                    <span asp-validation-for="AssetId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-12">
                                @* Full width for the quantity input *@
                                <div class="form-floating mb-4">
                                    @* Increased mb for more spacing before buttons *@
                                    <input asp-for="Quantity" class="form-control" required min="1" placeholder="Quantity" />
                                    <label asp-for="Quantity"></label>
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Investment" asp-action="Index" asp-route-portfolioId="@Model.PortfolioId" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left"></i> Back to Investments
                            </a>
                        
                            <button type="submit" class="btn" style=" background-color:#3498db">
                                <i class="fas fa-plus-circle"></i> Add Investment
                            </button>
                          
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Enable Bootstrap 5 tooltips (if you have any data-bs-toggle="tooltip" attributes)
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
}