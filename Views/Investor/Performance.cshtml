@using Newtonsoft.Json

@{
    Layout = ViewData["Layout"]?.ToString();
    ViewData["Title"] = "Portfolio Performance";

    var allocation = (Dictionary<string, decimal>)ViewBag.Allocation;
    var trend = (Dictionary<string, decimal>)ViewBag.Trend;
}

<h2>Portfolio Performance</h2>

<div class="row">
    <div class="col-md-6">
        <h5>Asset Allocation</h5>
        <canvas id="allocationChart"></canvas>
    </div>
    <div class="col-md-6">
        <h5>Gain/Loss Trend</h5>
        <canvas id="gainLossChart"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const allocationCtx = document.getElementById('allocationChart').getContext('2d');
        const gainLossCtx = document.getElementById('gainLossChart').getContext('2d');

        new Chart(allocationCtx, {
            type: 'pie',
            data: {
                labels: @Html.Raw(JsonConvert.SerializeObject(allocation.Keys)),
                datasets: [{
                    label: 'Allocation %',
                    data: @Html.Raw(JsonConvert.SerializeObject(allocation.Values)),
                    borderWidth: 1
                }]
            }
        });

        new Chart(gainLossCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(JsonConvert.SerializeObject(trend.Keys)),
                datasets: [{
                    label: 'Gain/Loss',
                    data: @Html.Raw(JsonConvert.SerializeObject(trend.Values)),
                    borderWidth: 1
                }]
            }
        });
    </script>
}
