@model InvestmentPortfolioManagement.Models.Portfolio

@{
    ViewData["Title"] = "Portfolio Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2>@Model.Name Details</h2>
                </div>
                <div class="card-body">
                    <p><strong>Description:</strong> @Model.Description</p>
                    <p><strong>Type:</strong> @Model.Type</p>
                    <p><strong>Total Value:</strong> @Model.TotalValue.ToString("C")</p>
                    <p><strong>Created Date:</strong> @Model.CreatedDate.ToShortDateString()</p>

                    <hr />

                    <h3><i class="fas fa-chart-line"></i> Portfolio Risk Analysis</h3>
                    <div id="portfolioRiskAnalysisSection" class="p-3 border rounded mb-3">
                        <p class="text-muted">Loading risk data...</p>
                    </div>

                    <button id="recalculatePortfolioRiskBtn" class="btn btn-info btn-sm">
                        <i class="fas fa-calculator"></i> Recalculate Risk
                    </button>

                    <hr />

                    <h3><i class="fas fa-history"></i> Risk Trend Over Time</h3>
                    <div class="chart-container" style="position: relative; height:40vh; width:80vw">
                        <canvas id="riskTrendChart"></canvas>
                    </div>
                    <p class="text-muted mt-2">Loading risk history...</p>
                    <div id="riskHistoryMessage"></div>

                </div>
                <div class="card-footer text-right">
                    <a asp-action="Index" class="btn btn-secondary">Back to Portfolios</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(document).ready(function () {
            var portfolioId = '@Model.PortfolioId'; // Get portfolio ID from the Model

            // --- Function to Load and Display Latest Portfolio Risk ---
            function loadPortfolioRisk() {
                $('#portfolioRiskAnalysisSection').html('<p class="text-info"><i class="fas fa-sync-alt fa-spin"></i> Loading latest risk data...</p>');
                $.ajax({
                    url: `/api/Risk/viewPortfolioRiskAnalysis/${portfolioId}`,
                    method: 'GET',
                    success: function (data) {
                        if (data) {
                            $('#portfolioRiskAnalysisSection').html(`
                                <p><strong>Current Risk Level:</strong> <span class="risk-level-${data.riskLevel.toLowerCase()}">${data.riskLevel}</span></p>
                                <p><strong>Risk Score:</strong> ${data.riskScore.toFixed(2)} / 100</p>
                                <p><strong>Last Assessed:</strong> ${new Date(data.analysisDate).toLocaleString()}</p>
                                <details>
                                    <summary>View Details</summary>
                                    <pre style="white-space: pre-wrap; word-wrap: break-word;">${data.analysisDetails || 'No detailed analysis available.'}</pre>
                                </details>
                            `);
                        } else {
                            $('#portfolioRiskAnalysisSection').html('<p class="text-warning"><i class="fas fa-exclamation-triangle"></i> No recent risk analysis found. Click "Recalculate Risk" to generate one.</p>');
                        }
                    },
                    error: function (xhr, status, error) {
                        $('#portfolioRiskAnalysisSection').html(`<p class="text-danger"><i class="fas fa-times-circle"></i> Failed to load risk data: ${xhr.responseJSON?.message || error}</p>`);
                    }
                });
            }

            // --- Function to Load and Display Portfolio Risk History (Chart) ---
            function loadPortfolioRiskHistory() {
                $('#riskTrendChart').parent().next('.text-muted').text('Loading risk history...');
                $('#riskHistoryMessage').empty();
                $.ajax({
                    url: `/api/Risk/viewPortfolioRiskHistory/${portfolioId}?days=90`, // Fetch last 90 days of history
                    method: 'GET',
                    success: function (data) {
                        if (data && data.length > 0) {
                            const labels = data.map(item => new Date(item.analysisDate).toLocaleDateString());
                            const riskScores = data.map(item => item.riskScore);
                            const riskLevels = data.map(item => item.riskLevel);

                            const ctx = document.getElementById('riskTrendChart').getContext('2d');
                            // Destroy existing chart if it exists to prevent re-rendering issues
                            if (window.portfolioRiskChart instanceof Chart) {
                                window.portfolioRiskChart.destroy();
                            }
                            window.portfolioRiskChart = new Chart(ctx, {
                                type: 'line',
                                data: {
                                    labels: labels,
                                    datasets: [{
                                        label: 'Portfolio Risk Score',
                                        data: riskScores,
                                        borderColor: 'rgb(75, 192, 192)',
                                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                                        tension: 0.3,
                                        fill: false,
                                        borderWidth: 2
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: false, // Allow custom height/width via CSS
                                    plugins: {
                                        title: {
                                            display: true,
                                            text: 'Portfolio Risk Trend (Last 90 Days)'
                                        },
                                        tooltip: {
                                            callbacks: {
                                                label: function(context) {
                                                    let label = context.dataset.label || '';
                                                    if (label) {
                                                        label += ': ';
                                                    }
                                                    const score = context.raw;
                                                    const level = riskLevels[context.dataIndex]; // Get corresponding risk level
                                                    return `${label}${score.toFixed(2)} (${level})`;
                                                }
                                            }
                                        }
                                    },
                                    scales: {
                                        y: {
                                            beginAtZero: true,
                                            title: {
                                                display: true,
                                                text: 'Risk Score (0-100)'
                                            },
                                            max: 100 // Risk score is 0-100
                                        },
                                        x: {
                                            title: {
                                                display: true,
                                                text: 'Date'
                                            }
                                        }
                                    }
                                }
                            });
                            $('#riskTrendChart').parent().next('.text-muted').text(''); // Clear loading message
                        } else {
                            $('#riskTrendChart').parent().next('.text-muted').text('');
                            $('#riskHistoryMessage').html('<p class="text-info"><i class="fas fa-info-circle"></i> Not enough risk history data available to display a chart for the last 90 days.</p>');
                            // Clear canvas if no data
                            const ctx = document.getElementById('riskTrendChart').getContext('2d');
                            if (window.portfolioRiskChart instanceof Chart) {
                                window.portfolioRiskChart.destroy();
                            }
                            ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);
                        }
                    },
                    error: function (xhr, status, error) {
                        $('#riskTrendChart').parent().next('.text-muted').text('');
                        $('#riskHistoryMessage').html(`<p class="text-danger"><i class="fas fa-times-circle"></i> Failed to load risk history: ${xhr.responseJSON?.message || error}</p>`);
                    }
                });
            }

            // --- Initial Load ---
            loadPortfolioRisk();
            loadPortfolioRiskHistory();

            // --- Recalculate Button Click Event ---
            $('#recalculatePortfolioRiskBtn').on('click', function () {
                var $btn = $(this);
                $btn.text('Recalculating...').prop('disabled', true).prepend('<i class="fas fa-spinner fa-spin mr-2"></i>');
                $('#portfolioRiskAnalysisSection').html('<p class="text-info"><i class="fas fa-sync-alt fa-spin"></i> Recalculating portfolio risk...</p>');

                $.ajax({
                    url: `/api/Risk/calculatePortfolioRisk/${portfolioId}`,
                    method: 'POST',
                    success: function (data) {
                        toastr.success('Risk recalculated successfully!'); // Using Toastr for notifications
                        loadPortfolioRisk(); // Reload the displayed risk data
                        loadPortfolioRiskHistory(); // Also reload history
                    },
                    error: function (xhr, status, error) {
                        toastr.error(`Error during recalculation: ${xhr.responseJSON?.message || error}`);
                        loadPortfolioRisk(); // Try to load existing data if recalculation failed
                    },
                    complete: function () {
                        $btn.html('<i class="fas fa-calculator"></i> Recalculate Risk').prop('disabled', false);
                    }
                });
            });
        });
    </script>
    <style>
        /* Basic styling for risk levels */
        .risk-level-low {
            color: #28a745;
            font-weight: bold;
        }
        /* Green */
        .risk-level-medium {
            color: #ffc107;
            font-weight: bold;
        }
        /* Orange */
        .risk-level-high {
            color: #dc3545;
            font-weight: bold;
        }
        /* Red */
        .risk-level-none {
            color: #6c757d;
            font-weight: bold;
        }
        /* Gray for 'None' or default */

        /* Optional: Add Toastr for notifications */
        /* Link to Toastr CSS */
        @*<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />*@
    </style>
    @*<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>*@
}