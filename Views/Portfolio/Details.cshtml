@model InvestmentPortfolioManagement.Models.Portfolio
@{
    ViewData["Title"] = "Portfolio Details";
}

<div class="container mt-5">
    <h2>Portfolio Details</h2>

    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@Model.Type</dd>

        <dt class="col-sm-3">Total Value</dt>
        <dd class="col-sm-9">@Model.TotalValue</dd>

        <dt class="col-sm-3">Created On</dt>
        <dd class="col-sm-9">@Model.CreatedDate.ToShortDateString()</dd>
    </dl>

    <a asp-asp-controller="Portfolio" asp-action="AddInvestments" asp-route-portfolioId="@Model.PortfolioId" class="btn btn-primary">Add Investment</a>
    <a asp-action="Edit" asp-route-id="@Model.PortfolioId" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>

<hr />
<h3 class="mt-4">Investments in this Portfolio</h3>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Asset Name</th>
            <th>Quantity</th>
            <th>Current Price</th>
            <th>Purchased Price</th>
            <th>Total Value</th>
            <th>Purchased Date</th>
        </tr>
    </thead>
    <tbody>
        @if (Model?.Investments != null && Model.Investments.Any()) // Prefer Model.Investments directly if possible
        {
            foreach (var investment in Model.Investments)
            {
                <tr>
                    <td>@investment.Asset.Name</td>
                    <td>@investment.Quantity</td>
                    <td>@investment.CurrentPrice</td>
                    <td>@investment.PurchasePrice</td>
                    <td>@(investment.CurrentPrice * investment.Quantity)</td>
                    <td>@investment.InvestmentDate.ToShortDateString()</td>
                </tr>
            }
        }
        else if (ViewBag.Investments != null) // Fallback to ViewBag if you still need it
        {
            foreach (var investment in ViewBag.Investments)
            {
                <tr>
                    <td>@investment.Asset.Name</td>
                    <td>@investment.Quantity</td>
                    <td>@investment.CurrentPrice</td>
                    <td>@investment.PurchasePrice</td>
                    <td>@(investment.CurrentPrice * investment.Quantity)</td>
                    <td>@investment.InvestmentDate.ToShortDateString()</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4">No investments found for this portfolio.</td>
            </tr>
        }
    </tbody>
</table>