<div class="container mt-5">
    <div class="details-and-buttons-container">
        <h2>Portfolio Details</h2>

        <dl class="row portfolio-details-box">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Type</dt> @*/*  */*@
            <dd class="col-sm-9">@Model.Type</dd>

            <dt class="col-sm-3">Total Value</dt>
            <dd class="col-sm-9" id="portfolioTotalValue">@Model.TotalValue.ToString("C")</dd>

            <dt class="col-sm-3">Created On</dt>
            <dd class="col-sm-9">@Model.CreatedDate.ToShortDateString()</dd>
        </dl>

        <div class="portfolio-actions">
            <a asp-controller="Portfolio" asp-action="AddInvestments" asp-route-portfolioId="@Model.PortfolioId" class="btn btn-primary">Add Investment</a> @*/*  */*@
            <a asp-action="Edit" asp-route-id="@Model.PortfolioId" class="btn btn-warning">Edit</a>

            <a asp-action="AllocationChart" asp-route-id="@Model.PortfolioId" class="btn btn-info">View Allocation Chart</a>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

    <hr />
    <h3 class="mt-4"><i class="fas fa-chart-line"></i> Portfolio Risk Analysis</h3>
    <div class="card mb-4">
        <div class="card-body">
            <div id="portfolioRiskAnalysisSection" class="p-3 border rounded mb-3">
                <p class="text-muted">Loading risk data...</p>
            </div>

            <button id="recalculatePortfolioRiskBtn" class="btn btn-info btn-sm">
                <i class="fas fa-calculator"></i> Recalculate Risk
            </button>
        </div>
    </div>

    <hr />
    <h3 class="mt-4"><i class="fas fa-history"></i> Risk Trend Over Time</h3>
    <div class="card mb-4">
        <div class="card-body">
            <div class="chart-container-risk">
                <canvas id="riskTrendChart"></canvas>
            </div>
            <p class="text-muted mt-2" id="riskHistoryLoadingMessage">Loading risk history...</p>
            <div id="riskHistoryMessage" class="mt-2"></div>
        </div>
    </div>
    <hr />
    <h3 class="mt-4">Investments in this Portfolio</h3>

    <table class="table table-bordered">
        <thead>
            <tr>
                @*/*  */*@
                <th>Asset Name</th>
                <th>Quantity</th>
                <th>Current Price</th>
                <th>Purchased Price</th>
                <th>Total Value</th>
                <th>P/L</th> @*/*  */*@
                <th>Purchased Date</th>
                <th>Actions</th> @* ADDED NEW HEADER *@ @*/*  */*@
            </tr>
        </thead>
        <tbody id="investmentsTableBody">
            @* Initial render of investments (will be updated by AJAX) *@
            @if (Model?.Investments != null && Model.Investments.Any()) @*/*  */*@
            {
                foreach (var investment in Model.Investments)
                {
                    // === FIX FOR CS0019 ERROR === @*/*  */*@
                    // Ensure currentAssetPrice is explicitly decimal, handling nulls with 0.0M @*/*  */*@
                    decimal currentAssetPrice = investment.Asset?.CurrentPrice ?? 0.0M; @*/*  */*@

                    // Explicitly cast investment.PurchasePrice to decimal just to be absolutely sure. @*/*  */*@
                    // Even if it's already decimal, this removes any ambiguity for the compiler. @*/*  */*@
                    decimal purchasePrice = (decimal)investment.PurchasePrice; @*/*  */*@
                    // Now, both operands are explicitly decimal, resolving the type mismatch. @*/*  */*@
                    decimal profitLoss = currentAssetPrice - purchasePrice; @*/*  */*@
                    // === END FIX === @*/*  */*@

                    string profitLossClass = profitLoss > 0 ? "profit" : (profitLoss < 0 ? "loss" : "neutral"); @*/*  */*@
                    string profitLossIcon = profitLoss > 0 ? "▲" : (profitLoss < 0 ? "▼" : "—"); // Unicode arrows @*/*  */*@
                    string formattedProfitLoss = $"{profitLoss.ToString("C")} <span class='{profitLossClass}'>({profitLossIcon})</span>"; @*/*  */*@
                    <tr>
                        @*/*  */*@
                        <td>@investment.Asset.Name</td>
                        <td>@investment.Quantity</td>
                        <td>@currentAssetPrice.ToString("C")</td> @* Using the explicit decimal variable *@
                        <td>@purchasePrice.ToString("C")</td> @* Using the explicit decimal variable *@ 
                        <td>@((currentAssetPrice * investment.Quantity)).ToString("C")</td> @* Using currentAssetPrice here too *@ @*/*  */*@
                        <td class="@profitLossClass">@Html.Raw(formattedProfitLoss)</td> @* New P/L column *@ @*/*  */*@
                        <td>@investment.InvestmentDate.ToShortDateString()</td>
                        <td>

                            <button class="btn btn-outline-primary btn-sm-chart view-chart-btn"
                                    data-asset-id="@investment.Asset.AssetId"
                                    data-asset-name="@investment.Asset.Name"
                                    data-purchase-price="@investment.PurchasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" /* * /
                                    data-current-price="@currentAssetPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" /* * /
                                    data-bs-toggle="modal" 
                                    data-bs-target="#chartModal">
                                @*/*  */*@
                                <i class="fa-solid fa-chart-line"></i> View Chart @*/*  */*@
                            </button>
                        </td>
                    </tr>
                }
            } @*/*  */*@
            else
            {
                <tr>
                    <td colspan="8">No investments found for this portfolio.</td>
                </tr>
            }
        </tbody> @*/*  */*@
    </table>

    @* --- CHART MODAL (Add this section) --- *@ @*/*  */*@
    <div class="modal fade" id="chartModal" tabindex="-1" aria-labelledby="chartModalLabel" aria-hidden="true">
        @*/*  */*@
        <div class="modal-dialog modal-lg">
            @*/*  */*@
            <div class="modal-content">
                @*/*  */*@
                <div class="modal-header">
                    @*/*  */*@
                    <h5 class="modal-title" id="chartModalLabel">Asset Performance</h5> @*/*  */*@
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button> @*/*  */*@
                </div>
                <div class="modal-body">
                    @*/*  */*@
                    <div id="chartLoadingIndicator" class="text-center my-3" style="display:none;">
                        @*/*  */*@
                        <div class="spinner-border text-primary" role="status">
                            @*/*  */*@
                            <span class="visually-hidden">Loading chart data...</span> @*/*  */*@
                        </div>
                        <p>Loading chart data...</p> @*/*  */*@
                    </div>
                    <div id="chartErrorMessage" class="alert alert-danger" style="display:none;"></div> @*/*  */*@
                    <canvas id="performanceChartCanvas" style="display:none;"></canvas> @*/*  */*@
                </div>
            </div>
        </div>
    </div>
    @* --- END CHART MODAL --- *@ @*/*  */*@

</div> @* End of main container *@

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @* <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" /> *@
    @* <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script> *@

    <script>
        // Existing JavaScript for portfolio updates
        const portfolioId = "@Model.PortfolioId"; // Get portfolio ID from model @*/*  */*@
        const portfolioTotalValueElement = document.getElementById('portfolioTotalValue'); @*/*  */*@
        const investmentsTableBody = document.getElementById('investmentsTableBody'); @*/*  */*@

        // --- NEW CHART-RELATED ELEMENTS & VARIABLES (from your provided code) ---
        const chartModalElement = document.getElementById('chartModal'); @*/*  */*@
        // Initialize Bootstrap Modal using its constructor
        const chartModal = new bootstrap.Modal(chartModalElement); @*/*  */*@
        const chartModalLabel = document.getElementById('chartModalLabel'); @*/*  */*@
        const ctx = document.getElementById('performanceChartCanvas').getContext('2d'); @*/*  */*@
        const chartCanvas = document.getElementById('performanceChartCanvas'); @*/*  */*@
        const chartLoadingIndicator = document.getElementById('chartLoadingIndicator'); @*/*  */*@
        const chartErrorMessage = document.getElementById('chartErrorMessage'); @*/*  */*@
        let performanceChart = null; @*/*  */*@
        let chartUpdateInterval = null; @*/*  */*@

        // Helper to format currency (can be reused) @*/*  */*@
        const formatAsCurrency = (value) => value.toLocaleString('en-IN', { style: 'currency', currency: 'INR' }); @*/*  */*@

        // Existing updatePortfolioData function (keep it as is for table updates) @*/*  */*@
        async function updatePortfolioData() {
            try {
                const response = await fetch(`/Portfolio/GetPortfolioLiveUpdates/${portfolioId}`); @*/*  */*@
                if (!response.ok) { @*/*  */*@
                    throw new Error(`HTTP error! status: ${response.status}`); @*/*  */*@
                }
                const data = await response.json(); @*/*  */*@
                // 1. Update Portfolio Total Value @*/*  */*@
                if (portfolioTotalValueElement) { @*/*  */*@
                    portfolioTotalValueElement.textContent = data.totalValue.toLocaleString('en-IN', { style: 'currency', currency: 'INR' }); @*/*  */*@
                }

                // 2. Update Investments Table @*/*  */*@
                if (investmentsTableBody) { @*/*  */*@
                    investmentsTableBody.innerHTML = ''; // Clear existing rows @*/*  */*@

                    if (data.investments && data.investments.length > 0) { @*/*  */*@
                        data.investments.forEach(investment => { @*/*  */*@
                            const row = document.createElement('tr'); @*/*  */*@

                            const currentPriceJs = parseFloat(investment.currentPrice); @*/*  */*@
                            const purchasePriceJs = parseFloat(investment.purchasePrice); @*/*  */*@
                            const profitOrLoss = currentPriceJs - purchasePriceJs; @*/*  */*@

                            let profitLossClass = ''; @*/*  */*@
                            let profitLossIcon = ''; @*/*  */*@

                            if (profitOrLoss > 0) { @*/*  */*@
                                profitLossClass = 'profit'; @*/*  */*@
                                profitLossIcon = '▲'; @*/*  */*@
                            } else if (profitOrLoss < 0) { @*/*  */*@
                                profitLossClass = 'loss'; @*/*  */*@
                                profitLossIcon = '▼'; @*/*  */*@
                            } else { @*/*  */*@
                                profitLossClass = 'neutral'; @*/*  */*@
                                profitLossIcon = '—'; @*/*  */*@
                            }

                            const formattedProfitLoss = `${profitOrLoss.toLocaleString('en-IN', { style: 'currency', currency: 'INR' })} <span class="${profitLossClass}">(${profitLossIcon})</span>`; @*/*  */*@
                            row.innerHTML = `
                                <td>${investment.assetName}</td>
                                <td>${investment.quantity}</td>
                                <td>${currentPriceJs.toLocaleString('en-IN', { style: 'currency', currency: 'INR' })}</td> @*/*  */*@
                                <td>${purchasePriceJs.toLocaleString('en-IN', { style: 'currency', currency: 'INR' })}</td> @*/*  */*@
                                <td>${(currentPriceJs * investment.quantity).toLocaleString('en-IN', { style: 'currency', currency: 'INR' })}</td> @*/*  */*@
                                <td class="${profitLossClass}">${formattedProfitLoss}</td> @*/*  */*@
                                <td>${investment.investmentDate}</td>
                                <td> @*/*  */*@
                                    <button class="btn btn-outline-primary btn-sm-chart view-chart-btn"
                                            data-asset-id="${investment.assetId}" @*/*  */*@
                                            data-asset-name="${investment.assetName}" @*/*  */*@
                                            data-purchase-price="${purchasePriceJs}" @*/*  */*@
                                            data-current-price="${currentPriceJs}" @*/*  */*@
                                            data-bs-toggle="modal" @*/*  */*@
                                            data-bs-target="#chartModal"> @*/*  */*@
                                        <i class="fa-solid fa-chart-line fa-beat fa-lg"></i> @*/*  */*@
                                    </button>
                                </td>
                            `; @*/*  */*@
                            investmentsTableBody.appendChild(row); @*/*  */*@
                        });
                    } else {
                        const noDataRow = document.createElement('tr'); @*/*  */*@
                        noDataRow.innerHTML = `<td colspan="8">No investments found for this portfolio.</td>`; // CHANGED colspan to 8 @*/*  */*@
                        investmentsTableBody.appendChild(noDataRow); @*/*  */*@
                    }
                }

            } catch (error) {
                console.error("Error fetching live portfolio data:", error); @*/*  */*@
            }
        }

        // --- NEW CHART LOGIC (copied from Investment Index, adjusted for 'seconds' in labels) --- @*/*  */*@

        // Function to fetch historical data (MOCK FUNCTION - YOU NEED TO IMPLEMENT THIS ON BACKEND) @*/*  */*@
        // This function should ideally fetch actual historical price data from your backend @*/*  */*@
        // for the given assetId. @*/*  */*@
        async function getHistoricalPrices(assetId) { @*/*  */*@
            // In a real application, you'd make an AJAX call here: @*/*  */*@
            // For example: @*/*  */*@
            // const response = await fetch(`/Investment/GetAssetHistoricalPrices?assetId=${assetId}`); @*/*  */*@
            // if (!response.ok) throw new Error(`Failed to fetch historical data: ${response.status}`); @*/*  */*@
            // return await response.json(); @*/*  */*@
            // Expected format: [{ timestamp: "...", price: ... }, ...] @*/*  */*@

            // MOCK DATA FOR DEMONSTRATION (replace with real API call or a service that provides historical data) @*/*  */*@
            // This generates 60 data points simulating 60 seconds of price movement @*/*  */*@
            console.warn("Using mock historical data. Implement /Investment/GetAssetHistoricalPrices (or similar) on your backend for real data."); @*/*  */*@
            const now = new Date(); @*/*  */*@
            const mockData = []; @*/*  */*@
            const initialPrice = 1000 + Math.random() * 500; // Random starting price @*/*  */*@
            for (let i = 0; i < 60; i++) { // Generate 60 points (e.g., last 60 seconds) @*/*  */*@
                const time = new Date(now.getTime() - (60 - i) * 1000); // 1-second intervals @*/*  */*@
                // Simple price simulation with some fluctuation @*/*  */*@
                const price = initialPrice + (Math.sin(i / 5) * 20) + (Math.random() - 0.5) * 10; @*/*  */*@
                mockData.push({ @*/*  */*@
                    timestamp: time.toISOString(), @*/*  */*@
                    price: price @*/*  */*@
                }); @*/*  */*@
            }
            return mockData; @*/*  */*@
        }

        // A) Function to LAUNCH the chart (called on button click) @*/*  */*@
        async function launchLiveChart(assetId, assetName, purchasePrice, initialCurrentPrice) { @*/*  */*@
            // Clear previous chart and hide canvas, show loading @*/*  */*@
            if (performanceChart) { performanceChart.destroy(); } @*/*  */*@
            chartCanvas.style.display = 'none'; @*/*  */*@
            chartErrorMessage.style.display = 'none'; @*/*  */*@
            chartLoadingIndicator.style.display = 'block'; @*/*  */*@

            chartModalLabel.textContent = `${assetName} Performance`; @*/*  */*@
            // Store the asset ID on the modal element for later updates @*/*  */*@
            chartModalElement.dataset.currentAssetId = assetId; @*/*  */*@
            let labels = []; @*/*  */*@
            let prices = []; @*/*  */*@

            try {
                // Fetch historical data @*/*  */*@
                const historicalData = await getHistoricalPrices(assetId); @*/*  */*@
                if (historicalData && historicalData.length > 0) { @*/*  */*@
                    labels = historicalData.map(d => new Date(d.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })); @*/*  */*@
                    prices = historicalData.map(d => parseFloat(d.price)); @*/*  */*@
                } else {
                    // Fallback if no historical data, start with purchase and initial current @*/*  */*@
                    labels = ['Purchased', new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })]; @*/*  */*@
                    prices = [purchasePrice, initialCurrentPrice]; @*/*  */*@
                }

                // Determine line color based on the current price relative to purchase price @*/*  */*@
                const lineColor = initialCurrentPrice >= purchasePrice ? 'rgb(40, 167, 69)' : 'rgb(220, 53, 69)'; // Green for profit, Red for loss @*/*  */*@

                performanceChart = new Chart(ctx, { @*/*  */*@
                    type: 'line', @*/*  */*@
                    data: { @*/*  */*@
                        labels: labels, @*/*  */*@
                        datasets: [ @*/*  */*@
                            { @*/*  */*@
                                label: 'Current Price (INR)', @*/*  */*@
                                data: prices, @*/*  */*@
                                borderColor: lineColor, @*/*  */*@
                                backgroundColor: lineColor.replace('rgb', 'rgba').replace(')', ', 0.2)'), // Light fill for the area below the line @*/*  */*@
                                fill: true, @*/*  */*@
                                tension: 0.4, // Smooths the line @*/*  */*@
                                pointRadius: 0 // Hides individual data points @*/*  */*@
                            },
                            { @*/*  */*@
                                label: 'Purchased Price', @*/*  */*@
                                data: new Array(labels.length).fill(purchasePrice), // Constant line at purchase price @*/*  */*@
                                borderColor: 'rgb(0, 123, 255)', // Blue for purchased price @*/*  */*@
                                borderDash: [5, 5], // Dashed line @*/*  */*@
                                backgroundColor: 'transparent', @*/*  */*@
                                pointRadius: 0, @*/*  */*@
                                borderWidth: 1 @*/*  */*@
                            }
                        ]
                    },
                    options: { @*/*  */*@
                        animation: { duration: 300 }, // Smooth animation for updates @*/*  */*@
                        responsive: true, @*/*  */*@
                        maintainAspectRatio: false, // Allows chart to resize freely within its container @*/*  */*@
                        scales: { @*/*  */*@
                            y: { @*/*  */*@
                                beginAtZero: false, // Prices might not start at zero @*/*  */*@
                                ticks: { @*/*  */*@
                                    callback: value => '₹' + value.toLocaleString('en-IN') // Format y-axis labels as currency @*/*  */*@
                                },
                                grid: { @*/*  */*@
                                    color: 'rgba(0,0,0,0.05)' // Light grid lines @*/*  */*@
                                }
                            },
                            x: { @*/*  */*@
                                display: true, @*/*  */*@
                                title: { @*/*  */*@
                                    display: true, @*/*  */*@
                                    text: 'Time' @*/*  */*@
                                },
                                ticks: { @*/*  */*@
                                    autoSkip: true, @*/*  */*@
                                    maxRotation: 0, @*/*  */*@
                                    minRotation: 0, @*/*  */*@
                                    maxTicksLimit: 10 // Control density of x-axis labels @*/*  */*@
                                },
                                grid: { @*/*  */*@
                                    color: 'rgba(0,0,0,0.05)' @*/*  */*@
                                }
                            }
                        },
                        plugins: { @*/*  */*@
                            legend: { @*/*  */*@
                                display: true, @*/*  */*@
                                labels: { @*/*  */*@
                                    boxWidth: 20 @*/*  */*@
                                }
                            },
                            tooltip: { @*/*  */*@
                                mode: 'index', @*/*  */*@
                                intersect: false, @*/*  */*@
                                callbacks: { @*/*  */*@
                                    title: function(context) { @*/*  */*@
                                        return `Time: ${context[0].label}`; @*/*  */*@
                                    },
                                    label: function(context) { @*/*  */*@
                                        let label = context.dataset.label || ''; @*/*  */*@
                                        if (label) { @*/*  */*@
                                            label += ': '; @*/*  */*@
                                        }
                                        if (context.parsed.y !== null) { @*/*  */*@
                                            label += formatAsCurrency(context.parsed.y); @*/*  */*@
                                        }
                                        return label; @*/*  */*@
                                    }
                                }
                            }
                        }
                    }
                }); @*/*  */*@
                chartCanvas.style.display = 'block'; // Show canvas after chart is created @*/*  */*@

            } catch (error) {
                console.error('Error fetching historical data or creating chart:', error); @*/*  */*@
                chartErrorMessage.textContent = `Failed to load chart data: ${error.message}. Please try again later.`; @*/*  */*@
                chartErrorMessage.style.display = 'block'; @*/*  */*@
            } finally {
                chartLoadingIndicator.style.display = 'none'; // Hide loading indicator regardless of success/failure @*/*  */*@
            }
        }

        // B) Function to UPDATE the chart (called by the interval) @*/*  */*@
        async function updateLiveChart() { @*/*  */*@
            const assetId = chartModalElement.dataset.currentAssetId; @*/*  */*@
            if (!assetId || !performanceChart) return; // Only update if modal is open and chart exists @*/*  */*@

            try {
                // Fetch only the relevant asset's current price
                // YOU NEED TO CREATE THE GetAssetCurrentPrice ENDPOINT in your PortfolioController (see below) @*/*  */*@
                const response = await fetch(`/Portfolio/GetAssetCurrentPrice/${assetId}`); @*/*  */*@
                if (!response.ok) { @*/*  */*@
                    // If asset not found or other HTTP error, hide chart and show error @*/*  */*@
                    chartModal.hide(); // Close the chart @*/*  */*@
                    throw new Error(`HTTP error! status: ${response.status}`); @*/*  */*@
                }
                const data = await response.json(); @*/*  */*@
                // Expected: { currentPrice: X.XX, assetName: "..." } @*/*  */*@

                if (data && data.currentPrice !== undefined) { @*/*  */*@
                    const newPrice = parseFloat(data.currentPrice); @*/*  */*@
                    const newLabel = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }); @*/*  */*@
                    // Add new data point @*/*  */*@
                    performanceChart.data.labels.push(newLabel); @*/*  */*@
                    performanceChart.data.datasets[0].data.push(newPrice); @*/*  */*@

                    // Ensure the purchase price line extends with the new data point @*/*  */*@
                    const purchasePrice = performanceChart.data.datasets[1].data[0]; // Get the initial purchase price @*/*  */*@
                    performanceChart.data.datasets[1].data.push(purchasePrice); @*/*  */*@
                    // Dynamically change line color based on real-time profit/loss @*/*  */*@
                    performanceChart.data.datasets[0].borderColor = newPrice >= purchasePrice ? 'rgb(40, 167, 69)' : 'rgb(220, 53, 69)'; @*/*  */*@
                    performanceChart.data.datasets[0].backgroundColor = (newPrice >= purchasePrice ? 'rgb(40, 167, 69)' : 'rgb(220, 53, 69)').replace('rgb', 'rgba').replace(')', ', 0.2)'); @*/*  */*@
                    // Keep a fixed number of data points (e.g., last 60 seconds) for a "rolling" chart @*/*  */*@
                    const maxPoints = 60; @*/*  */*@
                    if (performanceChart.data.labels.length > maxPoints) { @*/*  */*@
                        performanceChart.data.labels.shift(); // Remove oldest label @*/*  */*@
                        performanceChart.data.datasets[0].data.shift(); // Remove oldest current price @*/*  */*@
                        performanceChart.data.datasets[1].data.shift(); // Remove oldest purchase price point @*/*  */*@
                    }

                    performanceChart.update(); // Update the chart @*/*  */*@
                } else {
                    // If the asset data is invalid or asset no longer exists @*/*  */*@
                    chartModal.hide(); // Close the chart @*/*  */*@
                    console.warn(`Asset with ID ${assetId} not found or current price data is missing for chart update.`); @*/*  */*@
                }

            } catch (error) {
                console.error('Error during chart update:', error); @*/*  */*@
                // Optionally display error in modal or log it @*/*  */*@
            }
        }

        // --- NEW RISK MANAGEMENT JAVASCRIPT ---

        // Function to Load and Display Latest Portfolio Risk
        function loadPortfolioRisk() {
            $('#portfolioRiskAnalysisSection').html('<p class="text-info"><i class="fas fa-sync-alt fa-spin"></i> Loading latest risk data...</p>');
            $.ajax({
                url: `/api/Risk/viewPortfolioRiskAnalysis/${portfolioId}`,
                method: 'GET',
                success: function (data) {
                    if (data) {
                        $('#portfolioRiskAnalysisSection').html(`
                            <p><strong>Current Risk Level:</strong> <span class="risk-level-${data.riskLevel.toLowerCase()}">${data.riskLevel}</span></p>
                            <p><strong>Risk Score:</strong> ${data.riskScore.toFixed(2)} / 100</p>
                            <p><strong>Last Assessed:</strong> ${new Date(data.analysisDate).toLocaleString()}</p>
                            <details>
                                <summary>View Details</summary>
                                <pre style="white-space: pre-wrap; word-wrap: break-word;">${data.analysisDetails || 'No detailed analysis available.'}</pre>
                            </details>
                        `);
                    } else {
                        $('#portfolioRiskAnalysisSection').html('<p class="text-warning"><i class="fas fa-exclamation-triangle"></i> No recent risk analysis found. Click "Recalculate Risk" to generate one.</p>');
                    }
                },
                error: function (xhr, status, error) {
                    $('#portfolioRiskAnalysisSection').html(`<p class="text-danger"><i class="fas fa-times-circle"></i> Failed to load risk data: ${xhr.responseJSON?.message || error}</p>`);
                }
            });
        }

        // Function to Load and Display Portfolio Risk History (Chart)
        let portfolioRiskTrendChart = null; // Declare a variable to hold the Chart.js instance for risk trend
        function loadPortfolioRiskHistory() {
            $('#riskHistoryLoadingMessage').html('<p class="text-info"><i class="fas fa-sync-alt fa-spin"></i> Loading risk history...</p>');
            $('#riskHistoryMessage').empty(); // Clear any previous error/info messages
            $.ajax({
                url: `/api/Risk/viewPortfolioRiskHistory/${portfolioId}?days=90`, // Fetch last 90 days of history
                method: 'GET',
                success: function (data) {
                    $('#riskHistoryLoadingMessage').empty(); // Clear loading message

                    if (data && data.length > 0) {
                        const labels = data.map(item => new Date(item.analysisDate).toLocaleDateString());
                        const riskScores = data.map(item => item.riskScore);
                        const riskLevels = data.map(item => item.riskLevel);

                        const ctxRisk = document.getElementById('riskTrendChart').getContext('2d');
                        // Destroy existing chart if it exists to prevent re-rendering issues
                        if (portfolioRiskTrendChart instanceof Chart) {
                            portfolioRiskTrendChart.destroy();
                        }
                        portfolioRiskTrendChart = new Chart(ctxRisk, {
                            type: 'line',
                            data: {
                                labels: labels,
                                datasets: [{
                                    label: 'Portfolio Risk Score',
                                    data: riskScores,
                                    borderColor: 'rgb(75, 192, 192)',
                                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                                    tension: 0.3,
                                    fill: true, // Fill area below the line
                                    borderWidth: 2,
                                    pointRadius: 3, // Show points
                                    pointBackgroundColor: 'rgb(75, 192, 192)'
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false, // Allow custom height/width via CSS
                                plugins: {
                                    title: {
                                        display: true,
                                        text: 'Portfolio Risk Trend (Last 90 Days)'
                                    },
                                    tooltip: {
                                        callbacks: {
                                            label: function(context) {
                                                let label = context.dataset.label || '';
                                                if (label) {
                                                    label += ': ';
                                                }
                                                // Display score and corresponding level
                                                const score = context.raw;
                                                const level = riskLevels[context.dataIndex];
                                                return `${label}${score.toFixed(2)} (${level})`;
                                            }
                                        }
                                    }
                                },
                                scales: {
                                    y: {
                                        beginAtZero: true,
                                        title: {
                                            display: true,
                                            text: 'Risk Score (0-100)'
                                        },
                                        max: 100 // Risk score is 0-100
                                    },
                                    x: {
                                        title: {
                                            display: true,
                                            text: 'Date'
                                        }
                                    }
                                }
                            }
                        });
                    } else {
                        $('#riskHistoryMessage').html('<p class="text-info"><i class="fas fa-info-circle"></i> Not enough risk history data available to display a chart for the last 90 days.</p>');
                        // Clear canvas if no data
                        const ctxRisk = document.getElementById('riskTrendChart').getContext('2d');
                        if (portfolioRiskTrendChart instanceof Chart) {
                            portfolioRiskTrendChart.destroy();
                        }
                        ctxRisk.clearRect(0, 0, ctxRisk.canvas.width, ctxRisk.canvas.height);
                    }
                },
                error: function (xhr, status, error) {
                    $('#riskHistoryLoadingMessage').empty();
                    $('#riskHistoryMessage').html(`<p class="text-danger"><i class="fas fa-times-circle"></i> Failed to load risk history: ${xhr.responseJSON?.message || error}</p>`);
                }
            });
        }


        // --- EVENT LISTENERS (your existing ones + new risk ones) ---
        // Event delegation for dynamically added buttons @*/*  */*@
        // Listen for clicks on the table body to catch "View Chart" buttons @*/*  */*@
        investmentsTableBody.addEventListener('click', function(event) { @*/*  */*@
            const button = event.target.closest('.view-chart-btn'); @*/*  */*@
            if (button) { @*/*  */*@
                // Get data attributes @*/*  */*@
                const { assetId, assetName, purchasePrice, currentPrice } = button.dataset; @*/*  */*@

                // parseFloat is important as data-attributes are strings @*/*  */*@
                launchLiveChart(assetId, assetName, parseFloat(purchasePrice), parseFloat(currentPrice)); @*/*  */*@
            }
        }); @*/*  */*@

        // When the chart modal is shown, start the update interval @*/*  */*@
        chartModalElement.addEventListener('shown.bs.modal', function() { @*/*  */*@
            if (chartUpdateInterval) clearInterval(chartUpdateInterval); // Clear any existing interval @*/*  */*@
            chartUpdateInterval = setInterval(updateLiveChart, 1000); // Update chart every 1 second @*/*  */*@
        }); @*/*  */*@

        // When the chart modal is hidden, clear the update interval and destroy the chart @*/*  */*@
        chartModalElement.addEventListener('hidden.bs.modal', function() { @*/*  */*@
            clearInterval(chartUpdateInterval); @*/*  */*@
            if (performanceChart) { @*/*  */*@
                performanceChart.destroy(); // Destroy the chart instance to free up memory @*/*  */*@
                performanceChart = null; // Clear the reference @*/*  */*@
            }
        }); @*/*  */*@

        // --- Recalculate Portfolio Risk Button Click Event ---
        $('#recalculatePortfolioRiskBtn').on('click', function () {
            var $btn = $(this);
            $btn.text('Recalculating...').prop('disabled', true).prepend('<i class="fas fa-spinner fa-spin me-2"></i>'); // Use me-2 for margin-right in Bootstrap 5
            $('#portfolioRiskAnalysisSection').html('<p class="text-info"><i class="fas fa-sync-alt fa-spin"></i> Recalculating portfolio risk...</p>');

            $.ajax({
                url: `/api/Risk/calculatePortfolioRisk/${portfolioId}`,
                method: 'POST',
                success: function (data) {
                    // toastr.success('Risk recalculated successfully!'); // Uncomment if using Toastr
                    alert('Risk recalculated successfully!'); // Basic alert if no Toastr
                    loadPortfolioRisk(); // Reload the displayed risk data
                    loadPortfolioRiskHistory(); // Also reload history
                },
                error: function (xhr, status, error) {
                    // toastr.error(`Error during recalculation: ${xhr.responseJSON?.message || error}`); // Uncomment if using Toastr
                    alert(`Error during recalculation: ${xhr.responseJSON?.message || error}`); // Basic alert if no Toastr
                    loadPortfolioRisk(); // Try to load existing data if recalculation failed
                },
                complete: function () {
                    $btn.html('<i class="fas fa-calculator"></i> Recalculate Risk').prop('disabled', false);
                }
            });
        });


        // --- INITIAL EXECUTION ---
        // Call the function immediately on page load to populate the investments table @*/*  */*@
        updatePortfolioData(); @*/*  */*@
        // Set interval to update the entire portfolio table data every 5 seconds @*/*  */*@
        // This will re-render the table rows, updating current prices and P/L for all investments @*/*  */*@
        setInterval(updatePortfolioData, 1000); @*/*  */*@

        // Call functions to load risk data on page load
        loadPortfolioRisk();
        loadPortfolioRiskHistory();

    </script>
}