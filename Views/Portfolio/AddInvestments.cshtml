@model InvestmentPortfolioManagement.ViewModels.AddInvestmentsToPortfolioViewModel

@{
    ViewData["Title"] = "Add Investments to Portfolio";
}

<h2>Add Investments to Portfolio</h2>

<form asp-action="AddInvestments" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="PortfolioId" />

    <div class="form-group">
        <label>Select Investments</label>
        <select asp-for="SelectedInvestmentIds" asp-items="@(new MultiSelectList(Model.UnassignedInvestments, "InvestmentId", "AssetName"))"
                multiple="multiple" class="form-control">
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Add to Portfolio</button>
</form>
