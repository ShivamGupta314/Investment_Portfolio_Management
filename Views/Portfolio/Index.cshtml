@model IEnumerable<InvestmentPortfolioManagement.Models.Portfolio>
@{
    ViewData["Title"] = "Your Portfolios";
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InvestmentPortfolioManagement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InvestmentPortfolioManagement.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:400,500,300,700" />
    <link rel="stylesheet" href="~/css/portfolio-table.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>

@* REMOVED: <link rel="stylesheet" href="~/css/portfolio-table.css" asp-append-version="true" /> *@
@* This link should be in _Layout.cshtml (as we set up in a previous step) *@
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:400,500,300,700" />
<link rel="stylesheet" href="~/css/portfolio-table.css" asp-append-version="true" />
<section>
    @* This section applies the 50px margin from portfolio-table.css *@
    <h1>Your Portfolios</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <a asp-action="Create" class="btn btn-primary mb-3"><i class="fas fa-plus"></i> Portfolio</a>

    <div class="tbl-header">
        <table cellpadding="0" cellspacing="0" border="0">
            @* Removed Bootstrap table classes here *@
            <thead>
                <tr>
                    <th>Portfolio Name</th>
                    <th>Type</th>
                    <th>Total Value</th>
                    <th>Created Date</th>
                    <th colspan="2" style="padding-right:0">Actions</th>
                </tr>
            </thead>
        </table>
    </div>

    <div class="tbl-content">
        <table cellpadding="0" cellspacing="0" border="0">
            @* Removed Bootstrap table classes here *@
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Type</td>
                        <td id="totalValue_@item.PortfolioId"> @item.TotalValue.ToString("C")</td>
                        <td>@item.CreatedDate.ToShortDateString()</td>
                        <td class="portfolio-actions" colspan="2">
                            @* Using flexbox for better button layout *
                             * Removed d-grid, d-md-inline, mb-2, me-md-2 from individual buttons *@
                            <div class="d-flex flex-wrap gap-1">
                                <a asp-action="Details" asp-route-id="@item.PortfolioId" class="btn btn-info btn-sm" aria-label="View Portfolio"><i class="fas fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.PortfolioId" class="btn btn-warning btn-sm" aria-label="Edit Portfolio"><i class="fas fa-edit"></i></a>

                                <form asp-action="Delete" asp-route-id="@item.PortfolioId" method="get" class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this portfolio?');">
                                    <button type="submit" class="btn btn-danger btn-sm" aria-label="Delete Portfolio"><i class="fas fa-trash-alt"></i></button>
                                </form>

                                @* Removed Clone button as per original code *@
                                @* <form asp-action="Clone" asp-route-id="@item.PortfolioId" method="post" class="d-inline"> *@
                                @* <button type="submit" class="btn btn-outline-primary btn-sm">Clone</button> *@
                                @* </form> *@

                                <a asp-action="AllocationChart" asp-route-id="@item.PortfolioId" class="btn btn-secondary btn-sm" aria-label="View Allocation Chart"><i class="fas fa-chart-pie"></i></a>
                                <a asp-action="AddInvestments" asp-route-portfolioId="@item.PortfolioId"
                                   class="btn btn-success btn-sm" aria-label="Add Investment"><i class="fas fa-plus-circle"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
@* The portfolio-table.js script should ideally be linked in _Layout.cshtml *
             * The jQuery scrollbar adjustment part of portfolio-table.js needs the .tbl-header and .tbl-content divs *
        @* <script src="~/js/portfolio-table.js"></script> *@

    <script>
        // Your existing JavaScript for updating total values
        async function updatePortfolioTotalValues() {
            try {
                const response = await fetch('/Portfolio/GetLivePortfolioTotalValues');
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const data = await response.json(); // This will be an array of { portfolioId, totalValue }

                data.forEach(portfolioUpdate => {
                    const totalValueElement = document.getElementById(`totalValue_${portfolioUpdate.portfolioId}`);
                    if (totalValueElement) {
                        totalValueElement.textContent = portfolioUpdate.totalValue.toLocaleString('en-IN', { style: 'currency', currency: 'INR' });
                    }
                });

            } catch (error) {
                console.error("Error fetching live portfolio total values:", error);
            }
        }

        updatePortfolioTotalValues();
        setInterval(updatePortfolioTotalValues, 1000);
    </script>
}
<script src="~/js/portfolio-table.js"></script>