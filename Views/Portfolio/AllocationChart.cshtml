@{

    ViewData["Title"] = "Asset Allocation Chart";

    var portfolioId = ViewBag.PortfolioId;

}
<h2 class="text-center mb-4">Asset Allocation Chart</h2>
<div class="d-flex justify-content-center">
    <canvas id="pieChart" width="400" height="400"></canvas>
</div>
<div class="text-center mt-4">
    <a asp-action="Index" class="btn btn-secondary">Back to Portfolios</a>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>

        const ctx = document.getElementById('pieChart').getContext('2d');

        let chart;

        async function fetchDataAndRenderChart() {
           const response = await fetch(`/Portfolio/GetAllocationData/${'@portfolioId'}`);
           const data = await response.json();
           // ? Prevent .map on invalid data
           if (!Array.isArray(data)) {
               console.error("Invalid chart data:", data);
               return;
           }
           const labels = data.map(item => item.type);
           const values = data.map(item => item.totalAmount);
           if (chart) {
               chart.data.labels = labels;
               chart.data.datasets[0].data = values;
               chart.update();
           } else {
               chart = new Chart(ctx, {
                   type: 'pie',
                   data: {
                       labels: labels,
                       datasets: [{
                           data: values,
                           backgroundColor: [
                               '#007bff', '#28a745', '#ffc107', '#dc3545', '#6f42c1'
                           ],
                       }]
                   },
                   options: {
                       responsive: true,
                       maintainAspectRatio: false
                   }
               });
           }
        }

        fetchDataAndRenderChart();

        // Update every 10 sec
    </script>

}
